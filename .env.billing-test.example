# Copy to the ignored .env.billing-test.local. Never paste secrets into chat.
BILLING_TEST_MODE=isolated
BILLING_TEST_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# A NEW Supabase test project, never the website's current project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox/test mode only. No live keys or live price IDs.
STRIPE_SECRET_KEY=
# Signing secret printed by the matching Stripe CLI test listener.
STRIPE_WEBHOOK_SECRET=
# USD 9.99/month, USD 4.99/month, USD 99.99 once, USD 34.99 once.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_FOUNDER_LIFETIME=

# Optional, only if generating real prompts during the test. AI requests can cost money.
# ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-6
SCORE_AI_MODEL=claude-sonnet-4-6
