# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key — both are safe to expose to the browser.
# Get them from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The URL this app is served from. Used for auth redirects (magic link callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
# Get yours at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ── AI model selection (optional overrides) ────────────────────────────────────
# Which provider and model to use for prompt generation.
# Valid providers: anthropic | openrouter
# Valid models: claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-6

# Model used for scoring and optimization (defaults to claude-sonnet-4-6).
SCORE_AI_MODEL=claude-sonnet-4-6

# ── OpenRouter (optional) ─────────────────────────────────────────────────────
# Required only if DEFAULT_AI_PROVIDER=openrouter.
# Get yours at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ── Analytics: PostHog (optional) ─────────────────────────────────────────────
# All analytics calls are silent noops if this is not set — the app works without it.
# Create a free project at posthog.com, then copy the Project API Key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Rate limiting: Upstash Redis (optional, recommended for production) ────────
# Without these, rate limits use an in-memory fallback that resets on cold starts
# and is NOT reliable across concurrent serverless invocations.
# Create a free Redis database at upstash.com, then copy the REST credentials.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=
